# MongoDB Manager - Environment Variables
# Copy this file to .env and update the values

# ====================================
# Internal MongoDB (Session & User Storage)
# ====================================

# Internal database credentials (CHANGE IN PRODUCTION!)
# Used by the mongodb-manager app to store:
# - User accounts (admin username/password)
# - Authentication sessions
MANAGER_DB_USERNAME=manager_admin
MANAGER_DB_PASSWORD=changeme123

# Internal database connection URI (auto-configured in docker-compose.yml)
# Format: mongodb://username:password@host:port/database?authSource=admin
# MANAGER_DB_URI=mongodb://manager_admin:changeme123@manager-mongodb:27017/manager_app?authSource=admin

# ====================================
# App Authentication
# ====================================

# JWT Secret for API authentication (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-in-production-please-use-strong-secret

# Default admin password (first time login only)
# Username: admin
# Password: Set below
# IMPORTANT: You'll be forced to change this on first login
DEFAULT_ADMIN_PASSWORD=DEFAULT_ADMIN_PASSWORD_HERE

NODE_ENV=development/production

# ====================================
# Ports Configuration
# ====================================

# Backend API port (default: 9000)
BACKEND_PORT=9000

# Frontend Web UI port (default: 4000)
FRONTEND_PORT=4000

# ====================================
# CORS Configuration
# ====================================

# Allowed origins for CORS (comma-separated)
# Update ports if you changed FRONTEND_PORT above
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# ====================================
# Timezone
# ====================================

# Set timezone for timestamps
TZ=Europe/Paris

# ====================================
# Security Notes
# ====================================

# 1. Change MANAGER_DB_PASSWORD before deploying!
# 2. Change JWT_SECRET in production (use: openssl rand -base64 64)
# 3. Change DEFAULT_ADMIN_PASSWORD if needed
# 4. On first login, you'll be forced to change the default password
# 5. Password changes are instant (stored in MongoDB, no restart needed)
# 6. Session duration: 24 hours (stored in MongoDB)
# 7. Password minimum length: 8 characters
# 8. Internal MongoDB is isolated on Docker network (not exposed to host)
# 9. Expired sessions auto-delete via TTL index
# 10. User passwords are hashed with bcrypt (industry standard)
# 11. CORS_ORIGINS should match your frontend URL(s)
