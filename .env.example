# ====================================
# MongoDB Manager - Environment Template
#
# Usage:
#   cp .env.example .env.dev    # then: ./scripts/docker.sh dev up
#   cp .env.example .env.prod   # then: ./scripts/docker.sh prod up
#
# The docker.sh helper reads the file matching the environment name
# (".env.dev" for dev, ".env.prod" for prod). Both are gitignored.
# ====================================


# ====================================
# 1. WEB UI LOGIN (the password you type in the browser)
# ====================================
# This is NOT a database credential. It is the password of the "admin"
# user in the web interface login form.
# There is no username to set: the username is always "admin" and is
# not configurable.
#
#   - You are forced to change it after the first login
#     (unless NODE_ENV=development, which allows the default password).
#   - It is stored hashed (bcrypt) in the internal MongoDB, not in this file.
#   - Changing it here and restarting resets the password back to this value
#     (see "Password reset on restart" below).
#
# Default: admin123
# Generate a strong one:
#   openssl rand -base64 24
NUXT_ADMIN_PASSWORD=admin123

# The login username is hardcoded to "admin" (backend/app/core/auth.py).
# It is not configurable through an environment variable.


# ====================================
# 2. JWT SIGNING SECRET (internal)
# ====================================
# Secret used to sign the session tokens issued after login.
# Nobody ever types this, it is purely internal.
#
#   - Must be different for every deployment.
#   - Changing it logs every user out (all existing tokens become invalid).
#
# Generate with:
#   openssl rand -base64 64
NUXT_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64


# ====================================
# 3. INTERNAL MONGODB (app's own database)
# ====================================
# The private MongoDB shipped with the stack. It stores users, sessions
# and connection definitions. It is NOT the databases you back up.
#
# Leave these as-is unless the container name changes: the app runs inside
# the Docker network and reaches the database by service name.
#
# IMPORTANT: these credentials are only applied when the database volume is
# created for the first time. Changing them later has no effect on an
# existing volume, because MongoDB keeps the old credentials in its own
# config. To change them, destroy the volume (loses users and sessions):
#   ./scripts/docker.sh dev reset
NUXT_MONGODB_USERNAME=mongodb_manager_admin
NUXT_MONGODB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
NUXT_MONGODB_HOST=manager-mongodb
NUXT_MONGODB_PORT=27017
NUXT_MONGODB_DATABASE=MONGODB_MANAGER_DB


# ====================================
# 4. PORTS
# ====================================
# The ports used on YOUR machine (the Docker host), not inside the containers.
# The containers always listen on fixed internal ports; only the host side
# is configurable. Pick any free port on your machine.
#
# BACKEND_PORT  - the API, also serves the WebSocket terminal
# FRONTEND_PORT - the web interface you open in your browser
#
# Then open http://localhost:<FRONTEND_PORT>
BACKEND_PORT=9000
FRONTEND_PORT=4000

# Origins allowed to call the API from a browser.
# It reuses FRONTEND_PORT, so changing FRONTEND_PORT above is enough.
# Only touch this if you serve the app from a real domain, for example:
#   CORS_ORIGINS=https://manager.example.com
# Note: FRONTEND_PORT must be declared above this line (Compose reads
# the file from top to bottom).
CORS_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT}


# ====================================
# 5. BROWSER-SIDE API ADDRESSES
# ====================================
# Baked into the frontend bundle at build time, because the browser needs
# to know where to send requests.
#
# They reuse BACKEND_PORT from section 4, so changing that single value
# updates the API and the WebSocket too. Nothing to keep in sync here.
#
# Use https / wss if the app sits behind an HTTPS reverse proxy, for example:
#   NUXT_PUBLIC_API_URL=https://manager.example.com
#   NUXT_PUBLIC_WS_URL=wss://manager.example.com
#
# In dev these are injected by docker-compose.dev.yml from BACKEND_PORT.
# In prod they are build args, so changing them requires a rebuild:
#   ./scripts/docker.sh prod restart --no-cache
#
# Note: the ${...} syntax needs both braces. A single brace, like
# {BACKEND_PORT}, is passed through unchanged and breaks the URL.
NUXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
NUXT_PUBLIC_WS_URL=ws://localhost:${BACKEND_PORT}


# ====================================
# 6. MISC
# ====================================
# development | production
# In "development" the default password is accepted after login.
# In "production" you are forced to change it.
NODE_ENV=development

# Timezone used for log timestamps and backup file names.
# Examples: Europe/Paris, UTC, America/New_York
TZ=Europe/Paris

# Where backups are written. Set automatically by docker-compose to the
# "mongodb-backups-dev" / "mongodb-backups-prod" volume.
# Only change if you want backups on a host directory instead.
# BACKUP_BASE_DIR=/backups_mongodb_manager


# ====================================
# 7. OPTIONAL
# ====================================
# Full MongoDB URI. Overrides the 5 NUXT_MONGODB_* variables above.
# Handy to point the app at an existing MongoDB.
# Keep it commented unless you need it.
# MANAGER_DB_URI=mongodb://user:password@host:27017/database

# Set to true when deployed with Coolify (changes healthcheck behaviour).
# COOLIFY=true


# ====================================
# 8. FORGOT THE PASSWORD?
# ====================================
# Changing NUXT_ADMIN_PASSWORD here and RECREATING the containers resets the
# admin password to the new value (this file wins over the stored hash).
#
# To reset:
#   1. Edit NUXT_ADMIN_PASSWORD above
#   2. ./scripts/docker.sh dev down && ./scripts/docker.sh dev up
#
# "restart" is NOT enough: it reuses the existing containers, which keep the
# environment they were created with. Any change to this file needs a
# recreate, including the ports and the CORS origins.
#
# WARNING: this flags the account back to "default password", which
# re-triggers the forced password change on the next login.
#
# The same recreate rule applies to the NUXT_MONGODB_* variables, except
# those are only read when the database volume is created. Once the volume
# exists, MongoDB keeps the original credentials, so changing them has no
# effect. To actually change them:
#   ./scripts/docker.sh dev reset
# (destroys users, sessions and saved connections)
