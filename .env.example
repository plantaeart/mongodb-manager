# ====================================
# MongoDB Manager - Environment Template
# Copy this file to .env and update values
# ====================================

# ====================================
# MongoDB Connection (App → Database)
# ====================================
NUXT_MONGODB_USERNAME=mongodb_manager_admin
NUXT_MONGODB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
NUXT_MONGODB_HOST=manager-mongodb
NUXT_MONGODB_PORT=27017
NUXT_MONGODB_DATABASE=manager_app

# ====================================
# Application Authentication (User → App)
# ====================================
NUXT_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
NUXT_ADMIN_PASSWORD=admin123

# ====================================
# System Configuration
# ====================================
NODE_ENV=development
TZ=Europe/Paris
BACKEND_PORT=9000
FRONTEND_PORT=4000
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# ====================================
# Frontend API Configuration
# ====================================
NUXT_PUBLIC_API_URL=http://localhost:9000
NUXT_PUBLIC_WS_URL=ws://localhost:9000

# ====================================
# Security Notes
# ====================================
# 1. MongoDB credentials are for database access (not app login)
# 2. Admin password is for web UI login (username: admin)
# 3. Change ALL credentials in production!
# 4. JWT secret should be generated with: openssl rand -base64 64
# 5. Use strong passwords (32+ chars for production)
# 6. Special characters in passwords are automatically URL-encoded
