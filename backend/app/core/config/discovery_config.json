{
  "version": "1.0",
  "scan_settings": {
    "port_range": {
      "start": 27017,
      "end": 27030
    },
    "timeout_seconds": 2,
    "max_concurrent_scans": 10,
    "scan_docker_networks": true,
    "docker_network_ranges": [
      "172.17.0.0/24",
      "172.18.0.0/24",
      "172.19.0.0/24",
      "172.20.0.0/24",
      "172.21.0.0/24",
      "172.22.0.0/24"
    ],
    "custom_ip_ranges": []
  },
  "connection_defaults": {
    "auth_source": "admin",
    "ssl_enabled": false,
    "direct_connection": false
  }
}